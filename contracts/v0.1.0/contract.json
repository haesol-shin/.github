{
  "id": "repo-ops/v0.1.0",
  "issue": {
    "heading_level": 2,
    "required_heading_occurrences": 1,
    "required_heading_order": true,
    "required_headings": ["## Problem", "## Desired outcome", "## Work", "## Acceptance", "## Non-goals", "## Context"],
    "allow_additional_headings": true
  },
  "pull_request": {
    "heading_level": 2,
    "required_heading_occurrences": 1,
    "required_heading_order": true,
    "required_headings": ["## Summary", "## Changes", "## Impact", "## Verification", "## Risk and rollback", "## Related"],
    "allow_additional_headings": true,
    "changelog": {
      "declaration_prefix": "- Changelog:",
      "values": ["required", "not-required", "release"],
      "required_rationale": true,
      "release_version_pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$",
      "allowed_fragment_sections": ["Added", "Changed", "Deprecated", "Removed", "Fixed", "Security"]
    }
  },
  "round_limits": {
    "low": {
      "plan": null,
      "implementation": 2
    },
    "medium": {
      "plan": 3,
      "implementation": 3
    },
    "high": {
      "plan": 5,
      "implementation": 5
    }
  },
  "risk_authority": {
    "low": {
      "plan": "none",
      "approval_associations": [],
      "approval_permissions": []
    },
    "medium": {
      "plan": "required",
      "approval_associations": ["OWNER"],
      "approval_permissions": ["maintain", "admin"]
    },
    "high": {
      "plan": "required",
      "approval_associations": ["OWNER"],
      "approval_permissions": []
    }
  },
  "records": {
    "repo-ops.plan-approval.v1": {
      "schema": "plan-approval.schema.json",
      "field_order": ["decision", "risk", "issue", "intent", "plan", "plan-commit"]
    },
    "repo-ops.merge-review.v1": {
      "schema": "merge-review.schema.json",
      "field_order": ["verdict", "risk", "intent", "plan", "plan-round", "implementation-round", "base", "head", "diff", "runtime", "model"]
    },
    "repo-ops.intent.v1": {
      "schema": "intent.schema.json",
      "field_order": ["decision", "risk", "intent", "supersedes"]
    }
  },
  "repository_policy_schema": "repository-policy.schema.json"
}
