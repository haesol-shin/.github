{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/haesol-shin/.github/v0.1.0/contracts/v0.1.0/intent.schema.json",
  "title": "Accepted intent authority record",
  "type": "object",
  "additionalProperties": false,
  "required": ["record", "decision", "risk", "intent", "supersedes"],
  "properties": {
    "record": {
      "const": "repo-ops.intent.v1"
    },
    "decision": {
      "const": "accepted"
    },
    "risk": {
      "enum": ["low", "medium", "high"]
    },
    "intent": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "supersedes": {
      "type": "string",
      "pattern": "^(none|sha256:[0-9a-f]{64})$"
    }
  }
}
