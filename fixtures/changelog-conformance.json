{
  "contract": "repo-ops/v0.1.0",
  "description": "Language-independent changelog declaration and fragment lifecycle cases",
  "cases": [
    {
      "name": "required-owned-fragment",
      "input": {
        "route": "Related #3",
        "body": "## Summary\n\nPublish the contract.\n\nrepo-ops.changelog.v1 kind:required value:fragment-added\n\nRelated #3\n",
        "files": [
          {
            "filename": "changelog.d/3-repo-ops.md",
            "status": "added",
            "content": "## Added\n- Publish the contract.\n"
          }
        ]
      },
      "expected": {
        "valid": true,
        "findings": []
      }
    },
    {
      "name": "required-missing-fragment",
      "input": {
        "route": "Related #3",
        "body": "## Summary\n\nPublish the contract.\n\nrepo-ops.changelog.v1 kind:required value:fragment-added\n\nRelated #3\n",
        "files": []
      },
      "expected": {
        "valid": false,
        "findings": ["required changelog declarations need an added, modified, renamed, or copied fragment"]
      }
    },
    {
      "name": "issue-ownership-mismatch",
      "input": {
        "route": "Related #3",
        "body": "## Summary\n\nPublish the contract.\n\nrepo-ops.changelog.v1 kind:required value:fragment-added\n\nRelated #3\n",
        "files": [
          {
            "filename": "changelog.d/4-other.md",
            "status": "added",
            "content": "## Changed\n- Change another issue.\n"
          }
        ]
      },
      "expected": {
        "valid": false,
        "findings": ["issue-backed fragment filename must begin with the linked issue number"]
      }
    },
    {
      "name": "ordinary-direct-changelog-edit",
      "input": {
        "route": "Related #3",
        "body": "## Summary\n\nNo release note.\n\nrepo-ops.changelog.v1 kind:not-required value:plan-only\n\nRelated #3\n",
        "files": [
          {
            "filename": "CHANGELOG.md",
            "status": "modified"
          }
        ]
      },
      "expected": {
        "valid": false,
        "findings": ["ordinary pull requests must not edit CHANGELOG.md"]
      }
    },
    {
      "name": "malformed-fragment-section",
      "input": {
        "route": "Related #3",
